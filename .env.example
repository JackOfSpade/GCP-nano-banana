# Choose ONE auth path. Nano Banana Pro (gemini-3-pro-image-preview) is only
# served in `global`, so set GOOGLE_CLOUD_LOCATION=global for ADC.

# === Path A: Vertex AI via API key ===
# GOOGLE_CLOUD_API_KEY=your_api_key_here

# === Path B: Vertex AI via ADC (gcloud auth application-default login) ===
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
